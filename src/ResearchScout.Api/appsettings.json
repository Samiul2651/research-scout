{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Models the admin dashboard may switch between. A model is only offered if its provider's API key is set
  // (ANTHROPIC_API_KEY, GEMINI_API_KEY, DEEPSEEK_API_KEY, OPENAI_API_KEY).
  // Prices are USD per 1 million tokens, used by the cost budget. Checked Nov 2026; update when providers change them.
  "Llm": {
    "DefaultProvider": "anthropic",
    "DefaultModelId": "claude-haiku-5-5",
    "RequestTimeout": "00:02:00",
    "Models": [
      {
        // Haiku 5.5 rate for prompts up to 100K tokens. Above 100K it is $0.50 / $2.50.
        "Provider": "anthropic",
        "ModelId": "claude-haiku-5-5",
        "DisplayName": "Claude Haiku 5.5",
        "InputUsdPerMillion": 0.10,
        "OutputUsdPerMillion": 0.50
      },
      {
        "Provider": "gemini",
        "ModelId": "gemini-3.5-flash-lite",
        "DisplayName": "Gemini 3.5 Flash-Lite",
        "InputUsdPerMillion": 0.30,
        "OutputUsdPerMillion": 2.50
      },
      {
        // DeepSeek peak-hour rate (off-peak is half). Using peak keeps the daily cap safe.
        "Provider": "deepseek",
        "ModelId": "deepseek-flash",
        "DisplayName": "DeepSeek V4.1 Flash",
        "InputUsdPerMillion": 0.30,
        "OutputUsdPerMillion": 1.20
      }
    ]
  }
}
