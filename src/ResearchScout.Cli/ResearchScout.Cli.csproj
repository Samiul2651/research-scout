<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ResearchScout.Harness\ResearchScout.Harness.csproj" />
    <ProjectReference Include="..\ResearchScout.Papers\ResearchScout.Papers.csproj" />
    <ProjectReference Include="..\ResearchScout.Scout\ResearchScout.Scout.csproj" />
    <ProjectReference Include="..\ResearchScout.Infra\ResearchScout.Infra.csproj" />
    <ProjectReference Include="..\ResearchScout.Llm\ResearchScout.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>scout</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- One source of truth for the model list: the Api's appsettings.json. -->
    <Content Include="..\ResearchScout.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
