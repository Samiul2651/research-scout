# Copy to .env (never commit .env) or set with `dotnet user-secrets`.
# The app reads these names from environment variables.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Local dev (docker compose). In production: Qdrant Cloud URL + key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local dev (docker compose). In production: Supabase connection string.
DATABASE_URL=Host=localhost;Port=5432;Database=research_scout;Username=scout;Password=scout_dev_only

# Live demo guard (USD per UTC day)
DAILY_SPEND_CAP_USD=0.50
