# Copy to .env (git-ignored). The CLI, eval and API read these environment variables.

# --- LLM providers: set the ones you have. The dashboard only offers providers with a key. ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (Voyage AI, first 200M tokens free) ---
VOYAGE_API_KEY=

# --- Database ---
# Local: matches docker-compose.yml.
# Supabase: Project > Connect > "Session pooler" URL (IPv4; works from Render's free tier).
DATABASE_URL=postgresql://scout:scout_dev_only@localhost:5432/research_scout

# --- Vector DB ---
# Local: docker compose. Qdrant Cloud: the cluster URL (https://xxx.cloud.qdrant.io:6333) + API key.
# Leave empty to keep vectors in memory (lost on restart; fine for a quick try).
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

# --- Optional ---
# Raises Semantic Scholar's rate limit (free key: https://www.semanticscholar.org/product/api).
SEMANTIC_SCHOLAR_API_KEY=

# --- Live demo (API only) ---
ADMIN_PASSWORD=
DAILY_SPEND_CAP_USD=0.50
MAX_CONCURRENT_RUNS=3
# Comma-separated sites allowed to call the API from a browser (e.g. your portfolio). The built-in page needs nothing here.
ALLOWED_ORIGINS=
